{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "dist-tsc-web",
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src", "src/shared"]
}
